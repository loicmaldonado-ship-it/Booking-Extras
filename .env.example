# Modèle pour travailler en LOCAL : copier en .env.local puis compléter.
#   cp .env.example .env.local
# Aucune de ces valeurs n'est un secret de production : la base locale
# (npx supabase start) génère ses propres clés. Les vraies valeurs de prod
# vivent uniquement dans Vercel (Settings > Environment Variables).

# Base locale : valeurs affichées par `npx supabase status -o env`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé de chiffrement des mots de passe Gmail des cheffes (stockés en base).
# En local, n'importe quelle clé de 32 octets : `openssl rand -base64 32`
SECRETS_ENCRYPTION_KEY=

# Notifications push des candidat·es. En local : `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.com

# Envoi d'emails via Gmail. Laisser VIDE en local : les envois renvoient
# alors "Envoi automatique non configuré" au lieu de partir pour de vrai.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
