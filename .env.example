# Mode local sûr : bloque emails, Gmail, push et relais SMS, y compris avec npm start.
BOOKING_TEST_MODE=1

# Modèle pour travailler en LOCAL : copier en .env.local puis compléter.
#   cp .env.example .env.local
# Aucune de ces valeurs n'est un secret de production : la base locale
# (npx supabase start) génère ses propres clés. Les vraies valeurs de prod
# vivent uniquement dans Vercel (Settings > Environment Variables).

# Base locale : valeurs affichées par `npx supabase status -o env`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé de chiffrement des mots de passe Gmail des cheffes (stockés en base).
# En local, n'importe quelle clé de 32 octets : `openssl rand -base64 32`
SECRETS_ENCRYPTION_KEY=

# Notifications push des candidat·es. En local : `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.com

# Envoi d'emails via Gmail. Laisser VIDE en local : les envois renvoient
# alors "Envoi automatique non configuré" au lieu de partir pour de vrai.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Secret des routes de tâches planifiées (/api/cron/*). OBLIGATOIRE en préproduction et production :
# sans lui, les routes cron refusent toute requête. En local : `openssl rand -hex 32`.
CRON_SECRET=

# Secret du limiteur de tentatives de connexion candidate (hachage des clés de limitation).
# Facultatif : à défaut, SUPABASE_SERVICE_ROLE_KEY est utilisée. Recommandé distinct en production.
AUTH_RATE_LIMIT_SECRET=

# Facultatif, local uniquement : =1 pour autoriser la relève des boîtes Gmail hors production.
# RELEVE_MAILS_LOCAL=

# Facultatif, local uniquement : en mode test, capture les emails dans une boîte locale au lieu de les jeter
# (Mailpit de `supabase start`, interface http://127.0.0.1:54324). Hôte local/privé obligatoire. Ex. :
# (port fixe exposé par supabase/config.toml [local_smtp] smtp_port). Requis par la recette technique de la batterie.
BOOKING_TEST_SMTP_URL=smtp://127.0.0.1:54325
